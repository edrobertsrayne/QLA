# Copy to `.env` for local runs. Never commit real keys (`.env` is gitignored).
# Server OpenRouter key (fatal 500 when missing — the route checks this first).
OPENROUTER_API_KEY=sk-or-v1-...
# Default model for Phase 1 Parse (Gemini Flash via OpenRouter unless overridden per run).
OPENROUTER_MODEL=google/gemini-2.5-flash
# Raise above the adapter-node 512kb default so the 2.4MB AQA question paper
# passes; the route enforces its own per-file ~15MB + ~100pp caps with 413s.
# 32M covers two max-size PDFs plus multipart overhead in production.
# (No effect in `vite dev` — the platform limit only applies to built servers.)
BODY_SIZE_LIMIT=32M
